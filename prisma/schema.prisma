generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @db.VarChar(200)
  descripcion String? @db.VarChar(2000)
  precio      Decimal @db.Decimal(12, 2)
  stock       Int

  @@map("products")
}

model InventoryMovement {
  id             String   @id @db.Uuid
  productoId     String   @db.Uuid
  nombreProducto String   @db.VarChar(200)
  tipo           String   @db.VarChar(10)
  cantidad       Int
  stockAnterior  Int
  stockPosterior Int
  motivo         String   @db.VarChar(500)
  responsable    String   @db.VarChar(120)
  creadoEn       DateTime @default(now()) @db.Timestamptz(6)

  @@index([productoId, creadoEn])
  @@map("inventory_movements")
}
