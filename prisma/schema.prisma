generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String  @id @default(uuid()) @db.Uuid
  nombre      String  @db.VarChar(200)
  descripcion String? @db.VarChar(2000)
  precio      Decimal @db.Decimal(12, 2)
  stock       Int

  @@map("products")
}
